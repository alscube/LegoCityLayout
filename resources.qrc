<RCC>
    <qresource prefix="/images">
        <file alias="StrightTrack.png">resources/StrightTrack.png</file>
        <file alias="CurvedTrack.png">resources/CurvedTrack.png</file>
        <file alias="LeftSwitchTrack.png">resources/LeftSwitchTrack.png</file>
        <file alias="RightSwitchTrack.png">resources/RightSwitchTrack.png</file>
        <file alias="FlexTrack.png">resources/FlexTrack.png</file>
        <file alias="FlexTrackFemale.png">resources/FlexTrackFemale.png</file>
        <file alias="FlexTrackMale.png">resources/FlexTrackMale.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="units-IN.svg">resources/icons/units-IN.svg</file>
        <file alias="units-CM.svg">resources/icons/units-CM.svg</file>
        <file alias="units-ST.svg">resources/icons/units-ST.svg</file>
        <file alias="units-PL.svg">resources/icons/units-PL.svg</file>
        <file alias="ruler.svg">resources/icons/ruler.svg</file>
        <file alias="grid.svg">resources/icons/grid.svg</file>
        <file alias="grid-highlight.svg">resources/icons/grid-highlight.svg</file>
        <file alias="table.svg">resources/icons/table.svg</file>
        <file alias="city.svg">resources/icons/city.svg</file>
    </qresource>
</RCC>
